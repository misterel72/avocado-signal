---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  noIndex?: boolean;
}

const { title, description, currentPath = '/', noIndex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://avocadosignal.co.uk');
const canonicalPath = Astro.url.pathname === '/'
  ? '/'
  : Astro.url.pathname.replace(/\/$/, '');
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = new URL('/avocado-signal-social.png', siteUrl);

const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl.href}#organisation`,
      name: 'Avocado Signal',
      url: siteUrl.href,
      logo: new URL('/avocado-signal-logo.png', siteUrl).href,
      image: socialImageUrl.href,
      email: 'hello@avocadosignal.co.uk',
      description: 'Independent web design studio creating clear, lightweight websites and practical visual identities for small businesses.',
      slogan: 'Get found. Look good. Tread lightly.',
      founder: {
        '@type': 'Person',
        name: 'Ivan Langton',
        url: new URL('/about', siteUrl).href
      },
      areaServed: {
        '@type': 'Country',
        name: 'United Kingdom'
      },
      knowsAbout: [
        'Small business web design',
        'Websites for trades',
        'Website redesign',
        'Logo design',
        'Technical SEO',
        'Google Business Profile setup'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: 'Avocado Signal',
      description: 'Web design for small businesses in Somerset and across the UK.',
      publisher: { '@id': `${siteUrl.href}#organisation` },
      inLanguage: 'en-GB'
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl.href}#website` },
      about: { '@id': `${siteUrl.href}#organisation` },
      inLanguage: 'en-GB'
    }
  ]
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Ivan Langton" />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#173b2d" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-GB" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/png" href="/avocado-signal-icon.png" />
    <link rel="apple-touch-icon" href="/avocado-signal-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Avocado Signal" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Avocado Signal. Get found. Look good. Tread lightly." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(seoSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <a
      class="whatsapp-float"
      href="https://wa.me/97471670038?text=Hi%20Avocado%20Signal%2C%20I%27d%20like%20to%20talk%20about%20a%20website."
      target="_blank"
      rel="noreferrer"
      aria-label="Message Avocado Signal on WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.262.489 1.693.625.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.981.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.893 9.888-9.893 2.641 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.9 6.994c-.003 5.45-4.445 9.893-9.892 9.893m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.056 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
      <span class="whatsapp-label">WhatsApp</span>
    </a>
  </body>
</html>
