---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout title="Our Work | Avocado Signal" description="Explore interactive website design concepts for hospitality, tourism and UK trades. Browse real working demos by Avocado Signal." currentPath="/work">
<section class="shell showcase-intro">
 <p class="section-kicker">Selected work · Live demonstrations</p>
 <h1>Don't just look.<br/><span>Have a play.</span></h1>
 <p>Every preview below opens a real working website concept. Explore the navigation, scroll the pages and see what we could build for your business. These are design concepts, not claims of commissioned client work.</p>
</section>
<section class="shell showcase-list" aria-label="Website portfolio">
 {projects.map((project,index)=>(
 <article class="showcase-project" id={project.slug}>
  <div class="showcase-info"><span class="showcase-index">0{index+1} / {project.sector} / {project.location}</span><h2>{project.name}</h2><p>{project.summary}</p><span class="showcase-status">{project.status}</span>
   <div class="showcase-actions"><button type="button" class="button button-primary preview-trigger" data-preview={project.url} data-name={project.name}>Try the website ↗</button><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">Open full site ↗</a></div>
  </div>
  <div class="showcase-display"><div class="showcase-topbar"><span class="showcase-dots">● ● ●</span><span>{new URL(project.url).hostname}</span></div><div class="showcase-preview"><div class="showcase-letter">{project.name.slice(0,1)}</div><div><strong>{project.name}</strong><span>Interactive preview available</span></div><button type="button" class="preview-trigger showcase-open" data-preview={project.url} data-name={project.name}>Explore this design →</button></div></div>
 </article>
 ))}
</section>
<dialog id="project-preview" class="project-dialog" aria-label="Interactive website preview">
 <div class="preview-toolbar"><strong id="preview-name">Website preview</strong><div class="preview-tools"><button type="button" id="desktop-mode" aria-pressed="true">Desktop</button><button type="button" id="mobile-mode" aria-pressed="false">Mobile</button><a id="preview-external" target="_blank" rel="noopener noreferrer">Open full site ↗</a><button type="button" id="preview-close" aria-label="Close preview">✕</button></div></div>
 <div class="preview-stage"><iframe id="preview-frame" title="Interactive website demonstration" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
 <p class="preview-note">If the site doesn't appear, it may restrict embedding. Use “Open full site” instead.</p>
</dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#project-preview');
 const frame=document.querySelector<HTMLIFrameElement>('#preview-frame');
 const title=document.querySelector<HTMLElement>('#preview-name');
 const external=document.querySelector<HTMLAnchorElement>('#preview-external');
 const desktop=document.querySelector<HTMLButtonElement>('#desktop-mode');
 const mobile=document.querySelector<HTMLButtonElement>('#mobile-mode');
 const close=document.querySelector<HTMLButtonElement>('#preview-close');
 document.querySelectorAll<HTMLButtonElement>('.preview-trigger').forEach(button=>button.addEventListener('click',()=>{
  if(!dialog||!frame||!title||!external)return;
  const url=button.dataset.preview||'';if(!url.startsWith('https://'))return;
  title.textContent=button.dataset.name||'Website preview';frame.src=url;frame.title=(button.dataset.name||'Website')+' interactive preview';external.href=url;dialog.classList.remove('mobile-preview');desktop?.setAttribute('aria-pressed','true');mobile?.setAttribute('aria-pressed','false');dialog.showModal();
 }));
 desktop?.addEventListener('click',()=>{dialog?.classList.remove('mobile-preview');desktop.setAttribute('aria-pressed','true');mobile?.setAttribute('aria-pressed','false')});
 mobile?.addEventListener('click',()=>{dialog?.classList.add('mobile-preview');mobile.setAttribute('aria-pressed','true');desktop?.setAttribute('aria-pressed','false')});
 close?.addEventListener('click',()=>dialog?.close());
 dialog?.addEventListener('close',()=>{if(frame)frame.removeAttribute('src')});
 dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
</script>
<style>
 .showcase-intro{padding-top:5rem;padding-bottom:3rem}.showcase-intro h1{font-size:clamp(3.4rem,9vw,8rem);line-height:.96;letter-spacing:-.06em;margin:.5rem 0 1.5rem}.showcase-intro h1 span{color:#6b8d46}.showcase-intro>p:last-child{max-width:65ch;font-size:1.15rem}.showcase-list{padding-bottom:6rem}.showcase-project{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:clamp(1.5rem,5vw,5rem);align-items:center;padding:4rem 0;border-top:1px solid #cad3c6}.showcase-project:nth-child(even) .showcase-display{order:-1}.showcase-index{font-size:.78rem;text-transform:uppercase;letter-spacing:.12em}.showcase-info h2{font-size:clamp(2.1rem,4vw,4.4rem);line-height:1.05;margin:1rem 0}.showcase-info p{max-width:45ch}.showcase-status{display:inline-block;margin:1rem 0;padding:.35rem .7rem;border:1px solid currentColor;border-radius:999px;font-size:.8rem}.showcase-actions{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-top:1.3rem}.preview-trigger{cursor:pointer}.showcase-display{background:#153b2d;border-radius:1rem;padding:.75rem;box-shadow:0 25px 65px #152e2130;color:#fff}.showcase-topbar{display:flex;justify-content:space-between;gap:.5rem;font-size:.7rem;opacity:.8;padding:.4rem .6rem 1rem;overflow:hidden}.showcase-dots{color:#b4d183;white-space:nowrap}.showcase-preview{min-height:290px;border-radius:.55rem;background:linear-gradient(135deg,#e6edda,#c7d9b4);color:#173b2d;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;gap:1rem;padding:2rem}.showcase-letter{font-size:5rem;font-weight:800;line-height:1;opacity:.3}.showcase-preview strong{font-size:clamp(1.6rem,3vw,3rem);display:block}.showcase-preview span{display:block}.showcase-open{border:1px solid #173b2d;border-radius:100px;background:transparent;padding:.75rem 1.25rem;font-weight:700;color:inherit}.project-dialog{position:fixed;inset:3vh 3vw;margin:auto;width:94vw;max-width:none;height:94vh;max-height:none;padding:0;border:0;border-radius:1rem;background:#f5f2e8;color:#173b2d;overflow:hidden}.project-dialog::backdrop{background:#07170ee0}.preview-toolbar{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.8rem 1.2rem;background:#f5f2e8}.preview-tools{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}.preview-tools button,.preview-tools a{border:1px solid #9da995;border-radius:999px;padding:.45rem .8rem;background:transparent;color:#173b2d;text-decoration:none;cursor:pointer;font:inherit;font-size:.85rem}.preview-tools [aria-pressed=true]{background:#173b2d;color:#fff}.preview-stage{height:calc(100% - 105px);background:#c8d2c5;display:flex;justify-content:center;overflow:hidden}.preview-stage iframe{width:100%;height:100%;border:0;background:white}.mobile-preview .preview-stage iframe{width:390px;max-width:100%;box-shadow:0 0 35px #0003}.preview-note{font-size:.72rem;text-align:center;margin:.35rem}.showcase-open:hover,.showcase-open:focus-visible{background:#173b2d;color:white}@media(max-width:760px){.showcase-intro{padding-top:2.5rem}.showcase-project{grid-template-columns:1fr;padding:2.5rem 0}.showcase-project:nth-child(even) .showcase-display{order:initial}.showcase-preview{min-height:230px}.project-dialog{inset:0;width:100vw;height:100dvh;border-radius:0}.preview-toolbar{align-items:flex-start;flex-direction:column}.preview-stage{height:calc(100% - 165px)}}
</style>
</BaseLayout>