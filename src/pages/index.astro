---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Small business websites',
    text: 'Fast, focused sites for businesses that need a credible home on the web without paying for a bloated digital ecosystem.'
  },
  {
    number: '02',
    title: 'Refresh & rescue',
    text: 'Already have a website that feels tired, confusing or painfully 2014? We can simplify it, sharpen it and make it useful again.'
  },
  {
    number: '03',
    title: 'Hosting & launch',
    text: 'Domain, deployment and lightweight hosting can be handled too, so you are not left holding a folder of files and a puzzled expression.'
  }
];
---

<BaseLayout
  title="Web Design for Small Businesses | Avocado Signal"
  description="Clear, lightweight websites, logo design and local search setup for small businesses and trades in Somerset and across the UK."
  currentPath="/"
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Independent web studio · Somerset and UK-wide</p>
      <h1>Websites that work harder<br /><span>and weigh less.</span></h1>
      <p class="hero-intro">Avocado Signal builds clean, fast websites for small businesses and trades that need to look established, get found and win trust without buying a monster platform they will never use.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="mailto:hello@avocadosignal.co.uk">hello@avocadosignal.co.uk</a>
        <a class="text-link" href="/services">See what we build <span>→</span></a>
      </div>
      <div class="proof-strip" aria-label="Key benefits">
        <span>Fast by default</span>
        <span>Mobile first</span>
        <span>Low-code footprint</span>
        <span>No unnecessary bloat</span>
      </div>
    </div>

    <div class="hero-card" aria-hidden="true">
      <div class="browser-bar">
        <i></i><i></i><i></i>
        <span>yourbusiness.com</span>
      </div>
      <div class="mock-site">
        <div class="mock-brand">YOUR BUSINESS</div>
        <div class="mock-line long"></div>
        <div class="mock-line medium"></div>
        <div class="mock-button"></div>
        <div class="mock-grid"><div></div><div></div><div></div></div>
      </div>
      <div class="eco-chip">Lightweight build</div>
    </div>
  </section>

  <section class="manifesto">
    <div class="shell manifesto-grid">
      <p class="section-kicker">The simple idea</p>
      <div>
        <h2>Your website should help your business.<br />Not become another job.</h2>
        <p>Most small organisations do not need layers of plugins, dashboards and subscriptions. They need a site that loads quickly, explains what they do, builds trust and makes it easy for a customer to take the next step.</p>
      </div>
    </div>
  </section>

  <section class="search-intro shell" aria-labelledby="search-intro-heading">
    <p class="section-kicker">Built to be found</p>
    <div>
      <h2 id="search-intro-heading">Good design for people. Clear signals for search engines.</h2>
      <p>Each site starts with useful page titles, readable structure, technical search setup and content that says what the business does and where it works. For local firms, we can also help connect the website with Google Business Profile and Maps.</p>
      <div class="search-intro-links">
        <a class="text-link" href="/web-design-somerset">Web design for Somerset businesses <span>→</span></a>
        <a class="text-link" href="/websites-for-trades">Websites for trades <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section shell home-services">
    <div class="section-heading">
      <p class="section-kicker">What we do</p>
      <div>
        <h2>Useful web design.<br />Without the agency fog.</h2>
        <a class="text-link" href="/services">Explore all services <span>→</span></a>
      </div>
    </div>
    <div class="service-grid">
      {services.map((service) => (
        <article class="service-card">
          <span>{service.number}</span>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="tread-section">
    <div class="shell tread-grid">
      <div class="tread-intro">
        <p class="section-kicker">What “tread lightly” means</p>
        <h2>A lighter website, by design.</h2>
        <p>Every website uses energy. We reduce avoidable data transfer and computing by keeping each build proportionate to the job. The result is usually a faster site with fewer moving parts and less digital machinery running behind the scenes.</p>
      </div>

      <div class="tread-points">
        <article>
          <span>01</span>
          <h3>Built once</h3>
          <p>Static pages are prepared before visitors arrive, rather than rebuilt from a database for every visit.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Smaller transfers</h3>
          <p>Images and other assets are compressed so visitors only download what the page actually needs.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Scripts earn their place</h3>
          <p>We avoid trackers, plugins and third-party code unless they serve a clear and useful purpose.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Efficient delivery</h3>
          <p>Static-first hosting scales with demand instead of keeping unnecessary website machinery running.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-approach">
    <div class="shell home-approach-grid">
      <div>
        <p class="section-kicker light">A small, independent studio</p>
        <h2>You deal with the person who actually builds the website.</h2>
      </div>
      <div>
        <p>Avocado Signal is run by Ivan. That means one conversation, straightforward advice and no mysterious handover to somebody you have never met. The sites stay lean too, because unnecessary machinery is rarely good for people, budgets or the planet.</p>
        <a class="button button-light" href="/about">Meet Ivan</a>
      </div>
    </div>
  </section>

  <section class="cta shell" id="contact">
    <div>
      <p class="section-kicker light">Have a business. Need a better site?</p>
      <h2>Let’s give it a signal.</h2>
    </div>
    <a class="button button-light" href="mailto:hello@avocadosignal.co.uk">hello@avocadosignal.co.uk</a>
  </section>
</BaseLayout>
