---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    number: '01',
    title: 'Small business websites',
    intro: 'A credible, fast home on the web without an enterprise-sized platform hiding underneath it.',
    text: 'Ideal for independent businesses, local services and growing organisations that need to explain what they do clearly, build trust quickly and make it easy for customers to get in touch.',
    includes: ['Responsive design', 'Clear page structure', 'Performance-focused build', 'Basic search setup', 'Launch support']
  },
  {
    number: '02',
    title: 'Refresh & rescue',
    intro: 'Keep what works. Remove what does not. Make the whole thing feel useful again.',
    text: 'For existing sites that have become slow, cluttered, dated or difficult to update. We strip the experience back to what customers actually need and rebuild around that.',
    includes: ['Content and structure review', 'Visual refresh', 'Mobile improvements', 'Performance clean-up', 'Migration planning']
  },
  {
    number: '03',
    title: 'Hosting & launch',
    intro: 'The unglamorous technical bits handled without turning them into a mystery.',
    text: 'We can help connect domains, deploy the finished site and set up lightweight hosting so launch day does not end with a ZIP file and an awkward silence.',
    includes: ['Domain connection', 'Static deployment', 'SSL setup', 'Efficient global delivery', 'Handover guidance']
  },
  {
    number: '04',
    title: 'Logo & business essentials',
    intro: 'A practical visual identity that carries cleanly from the website into the things your customers actually see.',
    text: 'For new businesses that need a logo, or existing businesses that want matching cards, letterheads and email signatures. You receive proper files for screen and print, not a lonely JPEG trapped in somebody else\'s account.',
    includes: ['Logo starter', 'Colour and type choices', 'Business cards', 'Editable letterhead', 'Email signature']
  },
  {
    number: '05',
    title: 'Search & local presence',
    intro: 'A website should tell customers, Google and AI search tools the same clear story about your business.',
    text: 'Every build includes essential technical search setup. We can also help eligible local businesses establish or improve a Google Business Profile so the website, Search and Maps support one another.',
    includes: ['Page titles and descriptions', 'Search-friendly structure', 'Structured business data', 'Search Console setup', 'Google Business Profile support']
  }
];
---

<BaseLayout
  title="Small Business Web Design Services | Avocado Signal"
  description="Small business websites, website redesign, logo design, hosting and local search setup from Avocado Signal. Serving Somerset and businesses across the UK."
  currentPath="/services"
>
  <section class="page-hero shell">
    <p class="eyebrow">Services</p>
    <h1>Useful web design.<br /><span>Without the agency fog.</span></h1>
    <p class="page-intro">A small set of focused services for businesses that need a better website, not another software subscription to manage.</p>
  </section>

  <section class="service-list shell">
    {services.map((service) => (
      <article class="service-detail">
        <div class="service-detail-number">{service.number}</div>
        <div class="service-detail-copy">
          <h2>{service.title}</h2>
          <p class="service-lead">{service.intro}</p>
          <p>{service.text}</p>
        </div>
        <div class="service-includes">
          <p class="section-kicker">Typically includes</p>
          <ul>
            {service.includes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </section>

  <section class="quote-band">
    <div class="shell quote-band-inner">
      <p class="section-kicker light">Simple by default</p>
      <h2>We would rather build the five things your website needs well than sell you twenty things it does not.</h2>
    </div>
  </section>

  <section class="cta shell" id="contact">
    <div>
      <p class="section-kicker light">Not sure which service fits?</p>
      <h2>Tell us what is not working.</h2>
    </div>
    <a class="button button-light" href="mailto:hello@avocadosignal.co.uk">hello@avocadosignal.co.uk</a>
  </section>
</BaseLayout>
