---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Avocado Signal home">
    <span class="brand-mark" aria-hidden="true">
      <span class="avocado-body"><span class="avocado-pit"></span></span>
      <span class="signal-line signal-one"></span>
      <span class="signal-line signal-two"></span>
    </span>
    <span class="brand-copy">
      <strong>Avocado Signal</strong>
      <small>Good websites. Lighter footprint.</small>
    </span>
  </a>

  <nav aria-label="Primary navigation">
    <a href="/" class:list={{ active: isActive('/') }}>Home</a>
    <a href="/services" class:list={{ active: isActive('/services') }}>Services</a>
    <a href="/about" class:list={{ active: isActive('/about') }}>About</a>
    <a href="mailto:hello@avocadosignal.com" class="nav-cta" aria-label="Email hello@avocadosignal.com">hello@</a>
  </nav>
</header>
