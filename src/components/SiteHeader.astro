---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isActive = (path: string) => currentPath === path;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Avocado Signal home">
    <img class="brand-logo" src="/avocado-signal-emblem.png" alt="" width="56" height="56" />
    <span class="brand-copy">
      <strong>Avocado Signal</strong>
      <small>Get found. Look good. Tread lightly.</small>
    </span>
  </a>

  <nav aria-label="Primary navigation">
    <a href="/" class:list={{ active: isActive('/') }}>Home</a>
    <a href="/services" class:list={{ active: isActive('/services') }}>Services</a>
    <a href="/about" class:list={{ active: isActive('/about') }}>About</a>
    <a href="mailto:hello@avocadosignal.co.uk" class="nav-cta">Email us</a>
  </nav>
</header>
