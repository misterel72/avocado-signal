rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approved(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/pilotMembers/$(uid))
        && get(/databases/$(database)/documents/pilotMembers/$(uid)).data.enabled == true;
    }
    function shortText(d, key, max) { return d[key] is string && d[key].size() <= max; }
    function valid(d) {
      return d.keys().hasAll(['business','contact','email','stage','value','nextFollowUp','conceptUrl','notes','suppressed','draftSubject','draftBody','createdAt','updatedAt'])
        && d.keys().hasOnly(['business','contact','email','stage','value','nextFollowUp','conceptUrl','notes','suppressed','draftSubject','draftBody','createdAt','updatedAt'])
        && shortText(d,'business',120) && d.business.size() > 0
        && shortText(d,'contact',120) && shortText(d,'email',254)
        && d.stage in ['New','Contacted','Conversation','Proposal','Won','Archived']
        && d.value is number && d.value >= 0 && d.value <= 1000000
        && shortText(d,'nextFollowUp',10) && (d.nextFollowUp == '' || d.nextFollowUp.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && shortText(d,'conceptUrl',2048) && (d.conceptUrl == '' || d.conceptUrl.matches('^https://.*'))
        && shortText(d,'notes',4000) && d.suppressed is bool
        && shortText(d,'draftSubject',200) && shortText(d,'draftBody',8000)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /pilotMembers/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /users/{uid}/prospects/{id} {
      allow get: if approved(uid);
      allow list: if approved(uid) && request.query.limit != null && request.query.limit <= 201;
      allow create: if approved(uid) && valid(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if approved(uid) && valid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
